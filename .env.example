# --- Discord (https://discord.com/developers/applications) ---
DISCORD_TOKEN=            # Bot → Token
DISCORD_CLIENT_ID=        # General Information → Application ID
DISCORD_GUILD_ID=         # your server id (right-click server → Copy ID). Commands register instantly for this guild.

# --- Claude ---
ANTHROPIC_API_KEY=
ARBITER_MODEL=claude-opus-5
ARBITER_EFFORT=medium     # low | medium | high | xhigh | max  (medium keeps v1 under ~45s)
ARBITER_FAST_MODE=0       # 1 = Opus fast mode (up to 2.5x faster output, premium price). Great for a live demo.

# --- Preview server ---
PORT=3939
PUBLIC_BASE_URL=          # e.g. https://xyz.ngrok.app  (leave blank → http://localhost:3939; screenshots still post inline)
CHROMIUM_PATH=            # optional: explicit Chromium binary for Playwright

# --- Behaviour ---
DATA_DIR=./data
DEBOUNCE_MS=6000          # batch messages that land within this window into one agent turn (lets a conflict arrive as a pair)
NUDGE_MINUTES=3           # after a version posts, nudge silent stakeholders once after this long
FORK_TIMEOUT_MINUTES=5    # auto-resolve an A/B vote after this long if at least one vote is in
