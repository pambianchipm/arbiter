# --- Discord (https://discord.com/developers/applications) ---
DISCORD_TOKEN=            # Bot → Token
DISCORD_CLIENT_ID=        # General Information → Application ID
DISCORD_GUILD_ID=         # your server id (right-click server → Copy ID). Commands register instantly for this guild.

# --- Claude ---
ANTHROPIC_API_KEY=
ARBITER_MODEL=claude-opus-5
ARBITER_EFFORT=medium     # low | medium | high | xhigh | max  (medium keeps v1 under ~45s)
ARBITER_FAST_MODE=0       # 1 = Opus fast mode (up to 2.5x faster output, premium price). Great for a live demo.

# --- Preview server ---
PORT=3939
PUBLIC_BASE_URL=          # e.g. https://xyz.ngrok.app  (leave blank → http://localhost:3939; screenshots still post inline)
CHROMIUM_PATH=            # optional: explicit Chromium binary for Playwright

# --- Behaviour ---
DATA_DIR=./data
DEBOUNCE_MS=6000          # batch messages that land within this window into one agent turn (lets a conflict arrive as a pair)
NUDGE_MINUTES=3           # after a version posts, nudge silent stakeholders once after this long
FORK_TIMEOUT_MINUTES=5    # auto-resolve an A/B vote after this long if at least one vote is in

# --- Voice (optional): /voice join makes Arbiter listen in a voice channel ---
ELEVENLABS_API_KEY=       # speech-to-text (Scribe) + text-to-speech
ELEVENLABS_VOICE_ID=21m00Tcm4TlvTq8ikWAM
OPENAI_API_KEY=           # alternative speech-to-text (Whisper) if you don't have ElevenLabs
VOICE_STT=auto            # auto | elevenlabs | openai | off
VOICE_TTS=1               # 0 = listen only, never speak
VOICE_MODE=listen         # listen = act on relevant talk, skip side chat · address = only lines that say "Arbiter"
VOICE_DEBOUNCE_MS=12000   # spoken feedback batches this long so an exchange lands as one turn
VOICE_MIN_SECONDS=1.0     # ignore utterances shorter than this
VOICE_MIN_RMS=400         # ignore audio quieter than this (mic noise, breathing)
VOICE_SHOW_IGNORED=1      # 1 = skipped lines appear small in the thread so you can see what was filtered
VOICE_GATE_MODEL=claude-haiku-4-5   # the cheap model that decides relevant vs side talk

# --- Hosted / product mode (all optional; defaults suit local dev and demos) ---
METERING=0                # 1 = enforce render allowances per server (free/team/byok)
FREE_RENDERS_PER_MONTH=3
TEAM_RENDERS_PER_MONTH=40
UPGRADE_URL=              # only if you are NOT using the built-in Stripe checkout below
ARBITER_SECRET=           # any long random string; encrypts bring-your-own keys at rest. Required for /setup.
PREVIEW_TOKENS=           # 1/0; defaults to 1 when PUBLIC_BASE_URL is set. Preview and canvas URLs carry ?k=<token>.
ADMIN_TOKEN=              # unlocks the /live session index when hosted: /live?admin=<token>
MAX_CONCURRENT_RENDERS=3
RETENTION_DAYS=30         # hosted: delete idle Free sessions after this many days (the privacy policy promises it)
CONTACT_EMAIL=            # shown on the landing page and filled into /privacy and /terms
TEAM_PRICE_LABEL=$12 / month   # display only; keep in step with the Stripe price
PACK_PRICE_LABEL=$5
PACK_RENDERS=20

# --- Stripe (billing turns on only when all five of these and ARBITER_SECRET are set) ---
STRIPE_SECRET_KEY=        # sk_test_… while testing, sk_live_… (or a restricted rk_live_…) in production
STRIPE_WEBHOOK_SECRET=    # whsec_… from the webhook endpoint https://<domain>/stripe/webhook
STRIPE_PRICE_TEAM=        # price_… of the monthly Team subscription
STRIPE_PRICE_PACK=        # price_… of the one-time render pack
STRIPE_AUTOMATIC_TAX=0    # 1 once Stripe Tax is set up
